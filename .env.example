# Paper mode is the default. Nothing is signed or sent.
# Live trading requires ALL of:
#   MODE=live
#   WALLET_PRIVATE_KEY=<base58 secret or JSON byte array>
#   the CLI flag --confirm-live
# Never commit a real key. This file is an example only.

MODE=paper
WALLET_PRIVATE_KEY=
RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_CLUSTER=mainnet-beta

# Risk limits applied before any paper or live open.
MAX_POSITION_USD=250
MAX_OPEN_POSITIONS=3
DAILY_LOSS_CAP_USD=100
MIN_TVL_USD=5000
MIN_VOLUME_24H_USD=10000

# RugCheck normalised score is treated as higher-is-riskier.
# At or above this value the token fails. Danger-level risks fail regardless.
RUG_FAIL_SCORE=60
RUG_MIN_HOLDERS=30
RUG_FAIL_CLOSED=true

# Scanner / pipeline
SCAN_LIMIT=40
CONSIDER=6
HORIZON_HOURS=1

# Optional. DexScreener is used without a key. Birdeye is skipped when unset.
BIRDEYE_API_KEY=

# Forward recorder only. Read from the environment on the recording box.
# Never commit a real value. The recorder redacts this if it would be logged.
HELIUS_API_KEY=
