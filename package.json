{
  "name": "meteora-lp-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Paper-trading foundation for a Meteora DLMM liquidity-provider bot.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "simulate": "MODE=paper tsx src/index.ts run --fresh --horizon-hours 1",
    "start": "tsx src/index.ts run",
    "scan": "tsx src/index.ts scan",
    "monitor": "tsx src/index.ts monitor",
    "book": "tsx src/index.ts book",
    "tournament": "MODE=paper tsx src/index.ts tournament",
    "tournament-mark": "MODE=paper tsx src/index.ts tournament-mark",
    "daily": "MODE=paper tsx src/index.ts daily",
    "high-vol-edge": "MODE=paper tsx src/index.ts high-vol-edge",
    "frozen-book": "MODE=paper tsx src/index.ts frozen-book",
    "record": "MODE=paper tsx src/recorder/cli.ts record",
    "record:export": "MODE=paper tsx src/recorder/cli.ts export",
    "brief3": "MODE=paper tsx src/index.ts brief3",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@meteora-ag/dlmm": "^1.9.14",
    "@solana/web3.js": "^1.99.0",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
